# Database (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/ry-vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=GMT%2B8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Secret (change in production)
JWT_TOKEN_SECRET=change-me-in-production-min-32-chars

# OpenAI-compatible Chat / Embedding Gateway
LAWYER_AI_BASE_URL=https://api.openai.com/v1
LAWYER_AI_API_KEY=your_api_key
LAWYER_AI_MODEL=deepseek-chat
LAWYER_AI_EMBEDDING_ENABLED=true
