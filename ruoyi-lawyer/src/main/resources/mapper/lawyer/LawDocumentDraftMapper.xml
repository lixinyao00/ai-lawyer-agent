<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.lawyer.mapper.LawDocumentDraftMapper">

    <resultMap type="LawDocumentDraft" id="LawDocumentDraftResult">
        <result property="id"           column="id"             />
        <result property="userId"       column="user_id"        />
        <result property="templateCode" column="template_code"  />
        <result property="title"        column="title"          />
        <result property="formDataJson" column="form_data_json" />
        <result property="content"      column="content"        />
        <result property="status"       column="status"         />
        <result property="modelName"    column="model_name"     />
        <result property="createTime"   column="create_time"    />
        <result property="updateTime"   column="update_time"    />
    </resultMap>

    <resultMap type="com.ruoyi.lawyer.vo.DocumentDraftListVO" id="DocumentDraftListResult">
        <result property="id"           column="id"            />
        <result property="templateCode" column="template_code" />
        <result property="title"        column="title"         />
        <result property="status"       column="status"        />
        <result property="createTime"   column="create_time"   />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <sql id="selectDraftVo">
        select d.id, d.user_id, d.template_code, d.title, d.form_data_json, d.content,
               d.status, d.model_name, d.create_time, d.update_time
        from law_document_draft d
    </sql>

    <select id="selectDraftList" resultMap="DocumentDraftListResult">
        select d.id,
               d.template_code,
               d.title,
               d.status,
               d.create_time,
               d.update_time
        from law_document_draft d
        where d.user_id = #{userId}
        <if test="query != null">
            <if test="query.templateCode != null and query.templateCode != ''">
                and d.template_code = #{query.templateCode}
            </if>
            <if test="query.title != null and query.title != ''">
                and d.title like concat('%', #{query.title}, '%')
            </if>
        </if>
        order by d.id desc
    </select>

    <select id="selectByIdAndUserId" resultMap="LawDocumentDraftResult">
        <include refid="selectDraftVo"/>
        where d.id = #{id} and d.user_id = #{userId}
    </select>

    <insert id="insertDraft" parameterType="LawDocumentDraft" useGeneratedKeys="true" keyProperty="id">
        insert into law_document_draft (
            user_id, template_code, title, form_data_json, content, status,
            model_name, create_time, update_time
        ) values (
            #{userId}, #{templateCode}, #{title}, #{formDataJson}, #{content}, #{status},
            #{modelName}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updateDraftContent" parameterType="LawDocumentDraft">
        update law_document_draft
        set title       = #{title},
            content     = #{content},
            status      = #{status},
            update_time = #{updateTime}
        where id = #{id} and user_id = #{userId}
    </update>

    <delete id="deleteByIdAndUserId">
        delete from law_document_draft where id = #{id} and user_id = #{userId}
    </delete>

</mapper>
