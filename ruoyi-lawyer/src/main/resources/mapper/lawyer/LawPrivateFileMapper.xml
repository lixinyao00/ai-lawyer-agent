<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.lawyer.mapper.LawPrivateFileMapper">

    <resultMap type="LawPrivateFile" id="LawPrivateFileResult">
        <result property="id"           column="id"            />
        <result property="userId"       column="user_id"       />
        <result property="originalName" column="original_name" />
        <result property="storagePath"  column="storage_path"  />
        <result property="fileExt"      column="file_ext"      />
        <result property="fileSize"     column="file_size"     />
        <result property="sha256"       column="sha256"        />
        <result property="createTime"   column="create_time"   />
    </resultMap>

    <sql id="selectFileVo">
        select id, user_id, original_name, storage_path, file_ext, file_size, sha256, create_time
        from law_private_file
    </sql>

    <select id="selectByIdAndUserId" resultMap="LawPrivateFileResult">
        <include refid="selectFileVo"/>
        where id = #{id} and user_id = #{userId}
    </select>

    <select id="selectByUserIdAndSha" resultMap="LawPrivateFileResult">
        <include refid="selectFileVo"/>
        where user_id = #{userId} and sha256 = #{sha256}
        order by id desc
        limit 1
    </select>

    <insert id="insertFile" parameterType="LawPrivateFile" useGeneratedKeys="true" keyProperty="id">
        insert into law_private_file (
            user_id, original_name, storage_path, file_ext, file_size, sha256, create_time
        ) values (
            #{userId}, #{originalName}, #{storagePath}, #{fileExt}, #{fileSize}, #{sha256}, #{createTime}
        )
    </insert>

    <delete id="deleteFileByIdAndUserId">
        delete from law_private_file where id = #{id} and user_id = #{userId}
    </delete>

</mapper>
