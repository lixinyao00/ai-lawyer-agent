[
  {
    "code": "labor_arbitration",
    "name": "劳动仲裁申请书",
    "description": "适用于劳动者向劳动人事争议仲裁委员会申请仲裁，主张工资、经济补偿金、赔偿金等。",
    "fields": [
      {
        "key": "applicantName",
        "label": "姓名",
        "type": "text",
        "required": true,
        "placeholder": "如：张三",
        "maxLength": 200,
        "group": "申请人信息"
      },
      {
        "key": "applicantGender",
        "label": "性别",
        "type": "select",
        "required": true,
        "placeholder": "请选择性别",
        "maxLength": 20,
        "options": ["男", "女"],
        "group": "申请人信息"
      },
      {
        "key": "applicantBirth",
        "label": "出生日期",
        "type": "date",
        "required": false,
        "placeholder": "如：1990-01-01",
        "maxLength": 10,
        "group": "申请人信息"
      },
      {
        "key": "applicantIdCard",
        "label": "身份证号",
        "type": "idcard",
        "required": true,
        "placeholder": "18 位身份证号",
        "maxLength": 18,
        "group": "申请人信息"
      },
      {
        "key": "applicantPhone",
        "label": "联系电话",
