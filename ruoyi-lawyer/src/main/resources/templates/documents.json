        "group": "申请人信息"
      },
      {
        "key": "applicantAddress",
        "label": "住址",
        "type": "text",
        "required": true,
        "placeholder": "如：XX省XX市XX区XX路XX号",
        "maxLength": 200,
        "group": "申请人信息"
      },
      {
        "key": "employerName",
        "label": "单位名称",
        "type": "text",
        "required": true,
        "placeholder": "如：XX有限公司",
        "maxLength": 200,
        "group": "被申请人信息"
      },
      {
        "key": "employerCreditCode",
        "label": "统一社会信用代码",
        "type": "text",
        "required": false,
        "placeholder": "18 位统一社会信用代码",
        "maxLength": 200,
        "group": "被申请人信息"
      },
      {
        "key": "employerLegalRep",
        "label": "法定代表人",
        "type": "text",
        "required": false,
        "placeholder": "如：李四",
        "maxLength": 200,
        "group": "被申请人信息"
      },
      {
        "key": "employerAddress",
        "label": "单位地址",
        "type": "text",
        "required": true,
        "placeholder": "如：XX省XX市XX区XX路XX号",
        "maxLength": 200,
        "group": "被申请人信息"
      },
      {
        "key": "entryDate",
        "label": "入职日期",
        "type": "date",
        "required": true,
        "placeholder": "如：2020-03-01",
        "maxLength": 10,
        "group": "劳动关系"
      },
      {
        "key": "leaveDate",
        "label": "离职日期",
        "type": "date",
        "required": false,
        "placeholder": "如：2024-06-30",
        "maxLength": 10,
        "group": "劳动关系"
      },
      {
        "key": "position",
        "label": "岗位",
        "type": "text",
        "required": false,
        "placeholder": "如：销售经理",
        "maxLength": 200,
        "group": "劳动关系"
      },
      {
        "key": "monthlySalary",
        "label": "月工资(元)",
        "type": "money",
        "required": true,
        "placeholder": "如：8000.00",
        "maxLength": 20,
        "group": "劳动关系"
      },
      {
        "key": "arbitrationCommission",
        "label": "仲裁委员会名称",
        "type": "text",
        "required": true,
        "placeholder": "如：XX市劳动人事争议仲裁委员会",
        "maxLength": 200,
        "group": "仲裁请求"
      },
      {
        "key": "claims",
        "label": "仲裁请求",
        "type": "textarea",
        "required": true,
        "placeholder": "逐项列明请求事项及金额",
        "maxLength": 2000,
        "group": "仲裁请求"
      },
      {
        "key": "factsAndReasons",
        "label": "事实与理由",
        "type": "textarea",
        "required": true,
        "placeholder": "陈述劳动关系建立、履行、争议经过及法律依据",
        "maxLength": 2000,
        "group": "仲裁请求"
      },
      {
        "key": "evidenceList",
        "label": "证据清单",
        "type": "textarea",
        "required": false,
        "placeholder": "列明证据名称及证明目的",
        "maxLength": 2000,
        "group": "仲裁请求"
      }
    ]
  },
